# Production Environment Variables
# Copy this file to .env.production and fill in your production values

# Firebase Configuration (Production)
VITE_FIREBASE_API_KEY=your_production_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_VAPID_KEY=your_vapid_key

# Application Configuration
VITE_USE_EMULATOR=false

# Square Webhook Configuration
# Note: SQUARE_WEBHOOK_SIGNATURE_KEY should be set via Firebase CLI secrets
# Run: npx firebase functions:secrets:set SQUARE_WEBHOOK_SIGNATURE_KEY

# Production Settings
NODE_ENV=production
GENERATE_SOURCEMAP=false
