rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return request.auth != null && (request.auth.token.role == 'admin' || request.auth.token.role == 'superadmin');
    }
    
    function hasCartAccess(cartId) {
      return request.auth != null && request.auth.token.cartId == cartId;
    }
    
    // Carts - Admin write, public read (settings needed by queue page)
    match /carts/{cartId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Workers - Admin only (relaxed for development)
    match /workers/{workerId} {
      allow read, write: if isAdmin();
      allow read: if request.auth != null; // Allow authenticated users to read
    }
    
    // Orders - Admin or cart worker
    match /orders/{orderId} {
      allow read, write: if isAdmin();
      allow read, create, update: if hasCartAccess(request.resource.data.cartId);
      allow read: if true; // Public queue page
    }
    
    // Bridge Sync — Safari ↔ PWA synchronization channel.
    // Documents are keyed by device fingerprint (SHA-256 hash).
    // No authentication required; security comes from the fingerprint being
    // computationally infeasible to guess.
    //
    // Write: allowed when the incoming createdAt is the server timestamp
    //        (i.e. within a 1-minute clock skew of request.time).
    // Read:  allowed when the stored createdAt is within 30 minutes of now.
    match /bridge_sync/{fingerprint} {
      // Allow writes (create or overwrite) when createdAt is set to server time.
      // We accept up to 60 seconds of clock skew.
      allow write: if request.resource.data.keys().hasAll(['cartId', 'createdAt'])
                   && request.resource.data.createdAt == request.time;

      // Allow reads when the stored document's createdAt is within 30 minutes.
      allow read: if resource == null
                  || (resource.data.createdAt is timestamp
                      && request.time - resource.data.createdAt < duration.value(30, 'm'));
    }
  }
}
