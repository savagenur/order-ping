rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return request.auth != null && (request.auth.token.role == 'admin' || request.auth.token.role == 'superadmin');
    }
    
    function hasCartAccess(cartId) {
      return request.auth != null && request.auth.token.cartId == cartId;
    }
    
    // Carts - Admin write, public read (settings needed by queue page)
    match /carts/{cartId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Workers - Admin only (relaxed for development)
    match /workers/{workerId} {
      allow read, write: if isAdmin();
      allow read: if request.auth != null; // Allow authenticated users to read
    }
    
    // Orders - Admin or cart worker
    // Cloud Functions use Admin SDK (bypasses rules)
    match /orders/{orderId} {
      allow read: if true; // Public queue page
      
      // Admins can do anything
      allow write: if isAdmin();
      
      // Workers can create orders
      allow create: if hasCartAccess(request.resource.data.cartId);
      
      // Workers can update orders with restrictions
      allow update: if hasCartAccess(resource.data.cartId) && (
        // Allow legitimate status transitions
        (resource.data.status == "pending" && request.resource.data.status in ["ready", "declined"]) ||
        (resource.data.status == "ready" && request.resource.data.status in ["completed"]) ||
        (resource.data.status == "completed" && request.resource.data.status == "ready") ||
        // Allow updating fields without changing status
        (request.resource.data.status == resource.data.status)
      ) && (
        // CRITICAL: Prevent frontend from setting "expired" status
        // Only backend (Cloud Functions with Admin SDK) can set "expired"
        request.resource.data.status != "expired"
      );
    }
    
    // Webhook events - Cloud Functions only (Admin SDK bypasses rules)
    match /webhookEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if false; // Only Cloud Functions can write
    }
    
    // Users — primary cross-app sync document keyed by anonymous userId (UUID).
    // Stores: currentCartId, fcmToken, selectedOrderId, trackedOrderIds, lastActive.
    // Anyone can write their own doc (validated: userId field must match doc ID).
    // Reads are open so the PWA can bootstrap cartId on cold-start.
    match /users/{userId} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasAny(['currentCartId', 'fcmToken', 'selectedOrderId', 'trackedOrderIds', 'lastActive']);
    }
    
    // Order Counters - Admin write, cart worker read
    match /orderCounters/{cartId} {
      allow read: if hasCartAccess(cartId) || isAdmin();
      allow write: if isAdmin();
    }
  }
}
