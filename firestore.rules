rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /orders/{orderId} {
      // Anyone can read orders from any cart (for public queue)
      allow read: if true;
      
      // Workers can only create/update orders for their own cart
      allow create: if request.auth != null && 
                      request.resource.data.cartId == request.auth.token.cartId;
      
      allow update: if request.auth != null && 
                      resource.data.cartId == request.auth.token.cartId;
    }
  }
}